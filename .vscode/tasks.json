{
  "tasks": [
    {
      "label": "Create bin directory",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/bin\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Creates the bin output directory at the repository root."
    },
    {
      "type": "cppbuild",
      "label": "C/C++: clang++ build active file",
      "command": "/usr/bin/clang++",
      "args": [
        "-fcolor-diagnostics",
        "-fansi-escape-codes",
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/bin/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "Create bin directory",
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}
